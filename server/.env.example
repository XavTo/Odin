PORT=3000
# Local: ./data. Railway: mount a persistent volume at /data.
# RAILWAY_VOLUME_MOUNT_PATH is detected automatically.
# DATA_DIR=/data

# Railway: set this on Odin-Server to protect game access. Never use VITE_SITE_PASSWORD.
# SITE_PASSWORD=choose-a-private-password

# Owner only. Different from the shared site password.
# ADMIN_PASSWORD=choose-an-owner-only-password
